{
  "buildCommand": "pnpm --filter @workspace/site run build",
  "outputDirectory": "artifacts/site/dist/public",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "routes": [
    { "src": "/api/blog/(.*)", "dest": "/api/blog?__p=$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
